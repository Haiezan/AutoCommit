<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk.WindowsDesktop" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework><UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo><UseCodebase>true</UseCodebase>
    <GeneratePkgDefFile>true</GeneratePkgDefFile><IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <MinimumVisualStudioVersion>16.0</MinimumVisualStudioVersion>
    <DeployExtension Condition="'$(MSBuildRuntimeType)' == 'Core'">false</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="16.0.206" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.TeamFoundationServer.ExtendedClient" Version="16.170.0" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" />
    <ProjectReference Include="../AutoCommit.Core/AutoCommit.Core.csproj" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Security" /><Reference Include="System.Net.Http" /><Reference Include="System.Design" />
    <Compile Include="../AutoCommit.Vsix/*.cs" Link="%(Filename)%(Extension)" />
    <VSCTCompile Include="../AutoCommit.Vsix/Commands.vsct"><ResourceName>Menus.ctmenu</ResourceName></VSCTCompile>
    <None Update="source.extension.vsixmanifest"><SubType>Designer</SubType></None>
    <Content Include="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll">
      <Link>Newtonsoft.Json.dll</Link><IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="../AutoCommit.Core/DiffPlex-LICENSE.txt">
      <Link>DiffPlex-LICENSE.txt</Link><IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk.WindowsDesktop" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(CompileOnly)' != 'true' and Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
